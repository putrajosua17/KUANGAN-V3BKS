{
  "rules": {
    ".read": false,
    ".write": false,

    "system": {
      "bootstrapped": {
        ".read": true,
        ".write": "!data.exists() || (auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (!root.child('users').exists() && auth.uid === $uid))",
        "lastLoginAt": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "v3bks_finance_data__mini-soccer": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('units').child('mini-soccer').val() === true)",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('units').child('mini-soccer').val() === true && root.child('users').child(auth.uid).child('role').val() !== 'coach'))"
